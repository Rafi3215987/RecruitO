olor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="82" y="475" width="238" height="58" as="geometry"/></mxCell><mxCell id="licon7" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="85" y="543" width="190" height="90" as="geometry"/></mxCell><mxCell id="ltxt7" value="Interview conducted by a real person (interviewer).&#xa;&#xa;Live video call using free tools.&#xa;&#xa;AI may assist with question suggestions and job context (recommended, not mandatory)." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="44" y="637" width="274" height="100" as="geometry"/></mxCell><mxCell id="ltag7" value="Human-Led Interview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0C58B;strokeColor=#F0C58B;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="42" y="737" width="278" height="28" as="geometry"/></mxCell><mxCell id="low8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E9;strokeColor=#F1D995;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="350" y="465" width="270" height="310" as="geometry"/></mxCell><mxCell id="lnum8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B47B00;strokeColor=#B47B00;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="362" y="477" width="32" height="32" as="geometry"/></mxCell><mxCell id="lttl8" value="8. Record &amp; Transcribe Interview" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="402" y="475" width="206" height="58" as="geometry"/></mxCell><mxCell id="licon8" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="405" y="543" width="180" height="90" as="geometry"/></mxCell><mxCell id="ltxt8" value="Record interview audio/video (with consent).&#xa;&#xa;Convert speech to text using local/open-source speech-to-text models.&#xa;&#xa;Identify speakers (interviewer vs candidate) with timestamps." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="364" y="637" width="242" height="100" as="geometry"/></mxCell><mxCell id="ltag8" value="Interview Transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1D995;strokeColor=#F1D995;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="362" y="737" width="246" height="28" as="geometry"/></mxCell><mxCell id="low9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#D3C5F5;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="640" y="465" width="270" height="310" as="geometry"/></mxCell><mxCell id="lnum9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6B4ED8;strokeColor=#6B4ED8;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="652" y="477" width="32" height="32" as="geometry"/></mxCell><mxCell id="lttl9" value="9. Interview Q&amp;A Analysis" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="692" y="475" width="206" height="58" as="geometry"/></mxCell><mxCell id="licon9" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="695" y="543" width="180" height="90" as="geometry"/></mxCell><mxCell id="ltxt9" value="Automatically identify questions and candidate answers.&#xa;&#xa;Evaluate relevance, accuracy, completeness and communication quality.&#xa;&#xa;Link analysis to job requirements." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="654" y="637" width="242" height="100" as="geometry"/></mxCell><mxCell id="ltag9" value="Analysed Q&amp;A with Scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D3C5F5;strokeColor=#D3C5F5;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="652" y="737" width="246" height="28" as="geometry"/></mxCell><mxCell id="low10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFFAF0;strokeColor=#BFE6C1;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="930" y="465" width="300" height="310" as="geometry"/></mxCell><mxCell id="lnum10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3BA35A;strokeColor=#3BA35A;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="942" y="477" width="32" height="32" as="geometry"/></mxCell><mxCell id="lttl10" value="10. Consolidated Candidate Assessment" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="982" y="475" width="236" height="58" as="geometry"/></mxCell><mxCell id="licon10" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="985" y="543" width="190" height="90" as="geometry"/></mxCell><mxCell id="ltxt10" value="Combine CV analysis and interview analysis.&#xa;&#xa;Provide overall assessment with evidence from CV and transcript.&#xa;&#xa;Highlight streng