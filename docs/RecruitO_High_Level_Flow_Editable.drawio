" width="192" height="145" as="geometry"/></mxCell><mxCell id="tag4" value="Applications Collected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1D995;strokeColor=#F1D995;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="813" y="400" width="196" height="28" as="geometry"/></mxCell><mxCell id="step5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF9EF;strokeColor=#BFE4BE;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="1035" y="88" width="233" height="350" as="geometry"/></mxCell><mxCell id="num5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#36A15B;strokeColor=#36A15B;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1047" y="100" width="32" height="32" as="geometry"/></mxCell><mxCell id="ttl5" value="5. AI CV Screening &amp; Candidate Ranking" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1087" y="98" width="169" height="55" as="geometry"/></mxCell><mxCell id="icon5" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="1091.5" y="160" width="120" height="82" as="geometry"/></mxCell><mxCell id="txt5" value="Extract and parse information from varied CV formats (PDF, DOCX, etc.).&#xa;&#xa;Semantic match against job requirements.&#xa;&#xa;Score, rank and shortlist with explanations." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="1049" y="248" width="205" height="145" as="geometry"/></mxCell><mxCell id="tag5" value="Ranked Candidate List" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE4BE;strokeColor=#BFE4BE;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1047" y="400" width="209" height="28" as="geometry"/></mxCell><mxCell id="step6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F7;strokeColor=#F0B9D4;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="1278" y="88" width="233" height="350" as="geometry"/></mxCell><mxCell id="num6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C63D78;strokeColor=#C63D78;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1290" y="100" width="32" height="32" as="geometry"/></mxCell><mxCell id="ttl6" value="6. Schedule Interviews (Handled by AI Agent)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1330" y="98" width="169" height="55" as="geometry"/></mxCell><mxCell id="icon6" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="1334.5" y="160" width="120" height="82" as="geometry"/></mxCell><mxCell id="txt6" value="AI agent suggests available time slots for interviewer + candidate.&#xa;&#xa;Sends invitations/reminders via MCP.&#xa;&#xa;Shares meeting link and manages interview workflow." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="1292" y="248" width="205" height="145" as="geometry"/></mxCell><mxCell id="tag6" value="Interview Scheduled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0B9D4;strokeColor=#F0B9D4;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="1290" y="400" width="209" height="28" as="geometry"/></mxCell><mxCell id="mcp_clie