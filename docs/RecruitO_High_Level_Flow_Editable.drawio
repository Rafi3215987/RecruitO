<mxCell id="ttl1" value="1. Create Job Requirement" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="77" y="98" width="166" height="55" as="geometry"/></mxCell><mxCell id="icon1" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="80.0" y="160" width="120" height="82" as="geometry"/></mxCell><mxCell id="txt1" value="Define job title, role, skills, experience, qualifications and evaluation weights.&#xa;&#xa;Choose application deadline and settings." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="39" y="248" width="202" height="145" as="geometry"/></mxCell><mxCell id="tag1" value="Job Requirement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8DDF7;strokeColor=#B8DDF7;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="37" y="400" width="206" height="28" as="geometry"/></mxCell><mxCell id="step2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FAEE;strokeColor=#BDE5B7;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="267" y="88" width="238" height="350" as="geometry"/></mxCell><mxCell id="num2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3FA35A;strokeColor=#3FA35A;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="279" y="100" width="32" height="32" as="geometry"/></mxCell><mxCell id="ttl2" value="2. AI Generates &amp; Refines Job Description" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="319" y="98" width="174" height="55" as="geometry"/></mxCell><mxCell id="icon2" value="" style="shape=image;image=data:image/png;base64,;aspect=fixed;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="layer_edit"><mxGeometry x="326.0" y="160" width="120" height="82" as="geometry"/></mxCell><mxCell id="txt2" value="AI creates a clear, structured job description from interviewer requirements.&#xa;&#xa;Refine and edit before publishing.&#xa;&#xa;Includes skills, responsibilities, perks etc." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#243746;align=left;verticalAlign=top;spacing=3;" vertex="1" parent="layer_edit"><mxGeometry x="281" y="248" width="210" height="145" as="geometry"/></mxCell><mxCell id="tag2" value="Final Job Description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDE5B7;strokeColor=#BDE5B7;fontSize=12;fontStyle=1;fontColor=#17365D;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="279" y="400" width="214" height="28" as="geometry"/></mxCell><mxCell id="step3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFF;strokeColor=#D0C3F3;strokeWidth=1.5;" vertex="1" parent="layer_edit"><mxGeometry x="509" y="88" width="280" height="350" as="geometry"/></mxCell><mxCell id="num3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6950D8;strokeColor=#6950D8;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="521" y="100" width="32" height="32" as="geometry"/></mxCell><mxCell id="ttl3" value="3. Post Job via MCP (Social/Job Channels)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#122B57;align=left;verticalAlign=middle;" vertex="1" parent="layer_edit"><mxGeometry x="561" y="98" width="216" height="55" as="geometry"/></mxCell><mxCell id="txt3" value="MCP Client (Recruitment Agent)&#xa;&#xa;Uses MCP servers to post to multiple free/approved platforms.&#xa;&#xa;Handles different plat