# Map used to upgrade proxied connections to WebSockets when the client asks for it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Allow large multipart uploads (the manager batch CV import can send up to
    # 50 CVs at once). The default 1 MB rejected any multi-CV upload with 413,
    # which the UI then mislabeled as a single-file "10 MB" error.
    client_max_body_size 200m;

    # Same-origin app: the API is reached under /api, so connect-src 'self' covers REST
    # and WebSockets; https:/wss: allow a future LiveKit Cloud (wss://*.livekit.cloud).
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https: wss:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' https: data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'" always;
    # Always revalidate static assets so code/style updates reach returning users
    # on the next reload (nginx still answers unchanged files with a cheap 304).
    add_header Cache-Control "no-cache" always;

    # Reverse-proxy the FastAPI backend (and its WebSockets) under /api on the same
    # origin. The trailing slash on proxy_pass strips the /api prefix, so
    # /api/applications -> http://api:8000/applications.
    location /api/ {
        # Resolve the backend at REQUEST time via Docker's embedded DNS (127.0.0.11),
        # so a container restart that changes the API's IP never leaves nginx proxying
        # a stale address (which showed up as 502 Bad Gateway after reboots).
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $api_upstream api;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
