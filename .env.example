# Local-only database defaults so `cp .env.example .env && docker compose up --build` starts cleanly.
# Change the password for anything other than a local demo.
POSTGRES_USER=recruito
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=recruito
DATABASE_URL=postgresql://recruito:change_me_local_only@db:5432/recruito

GEMINI_API_KEY=
SCORING_MODEL=gemini-3.1-flash-lite
# Concurrent CV scoring calls during batch imports (N1 throughput).
SCREENING_CONCURRENCY=4
ASSESSMENT_MODEL=gemini-3-flash-preview
TRANSCRIPTION_MODEL=gemini-3-flash-preview
CHAT_MODEL=gemini-3.1-flash-lite
# Interview speech-to-text uses AssemblyAI. Create a free key at https://www.assemblyai.com/.
ASSEMBLYAI_API_KEY=
FACE_MODELS_DIR=/opt/recruito/models
APP_ENV=development

# Exact browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Optional LAN-only development allowance for frontend origins on RFC1918 IPv4 addresses.
# Disable this in any deployment where the API is reachable from untrusted networks.
CORS_ORIGIN_REGEX=^http://(?:(?:10(?:\.\d{1,3}){3})|(?:192\.168(?:\.\d{1,3}){2})|(?:172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})):5500$
FRONTEND_LAN_HOST=localhost

# Blogger Mail2Blogger publishing. Use the public HTTPS addresses for RecruitO and the blog.
PUBLIC_BASE_URL=
ALLOW_LOCAL_BLOGGER_URL=false
BLOGGER_SITE_URL=https://recruito.blogspot.com
BLOGGER_POST_EMAIL=
BLOGGER_MCP_URL=http://blogger-mcp:8001/mcp
AUTO_PUBLISH_TO_BLOGGER=true

JWT_SECRET_KEY=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Local HTTP development only. Set true when serving the API over HTTPS.
COOKIE_SECURE=false
HIRING_MANAGER_EMAIL=manager@example.com
HIRING_MANAGER_PASSWORD=replace_with_a_local_password
HIRING_MANAGER_NAME=Demo Hiring Manager

# Configure SMTP to deliver application, status, interview, and reminder emails.
# These real SMTP values are used whenever SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Fallback used only if SMTP_HOST above is blank. Set these to a real SMTP
# server; there is no local mail catcher.
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_SENDER=
APP_MAIL_USE_TLS=true
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=

# LiveKit Cloud powers the interview video across different networks (hosted SFU/TURN).
# Create a free project at https://cloud.livekit.io and paste its three values here.
# Video falls back to peer-to-peer (same-network only) when these are blank.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
